---
import { asheConfig } from "../ashe.config";
import FooterWidgets from "./FooterWidgets.astro";

const footerClass = `${asheConfig.layout.footerWidth === "boxed" ? "boxed-wrapper " : ""}clear-fix`;
const innerClass = `page-footer-inner ${
  asheConfig.layout.footerWidth === "contained" ? "boxed-wrapper" : ""
}`.trim();
---

<footer id="page-footer" class={footerClass}>
  {
    asheConfig.footer.showScrollTop ? (
      <span class="scrolltop">
        <i class="fa-solid fa-angle-up"></i>
      </span>
    ) : null
  }

  <div class={innerClass}>
    <FooterWidgets />
  </div>
</footer>
