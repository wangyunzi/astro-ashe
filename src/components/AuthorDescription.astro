---
import { asheConfig } from "../ashe.config";
import { authorHref, type PostEntry } from "../lib/ashe";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { fallbackAvatar, fallbackBio, fallbackBioEn } = asheConfig.author;
---

<div class="author-description">
  <div class="author-avatar">
    <img src={fallbackAvatar} alt="" width="80" height="80" />
  </div>
  <h4>
    <a href={authorHref(post.data.author)}>{post.data.author}</a>
  </h4>
  <p data-i18n-en={post.data.authorBio ? undefined : fallbackBioEn}>{post.data.authorBio || fallbackBio}</p>
</div>
