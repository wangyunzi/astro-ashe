---
import { asheConfig } from "../ashe.config";
import { commentPath, type PostEntry } from "../lib/ashe";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const comments = asheConfig.comments;
const twikoo = comments.twikoo;
const path = commentPath(post);
---

{
  (
    <section class="comments-area" id="comments">
      {!twikoo.envId ? (
        <p
          class="twikoo-config-notice"
          data-i18n-html-en="Twikoo is ready. Set <code>comments.twikoo.envId</code> in <code>src/ashe.config.ts</code> to enable the comment box."
        >
          Twikoo 已就绪。请在 <code>src/ashe.config.ts</code> 中设置 <code>comments.twikoo.envId</code> 以启用评论框。
        </p>
      ) : null}

      <div id="twikoo">
        {twikoo.envId ? <p class="twikoo-config-notice" data-i18n="comments.loading">评论加载中...</p> : null}
      </div>

      {twikoo.envId ? (
        <script
          define:vars={{
            twikooCdn: twikoo.cdn,
            twikooEnvId: twikoo.envId,
            twikooPath: path,
            twikooLang: twikoo.lang
          }}
        >
          var twikooRoot = document.querySelector("#twikoo");
          var twikooTextMap = {
            "zh-CN": {
              loadFailed: "评论加载失败：",
              clientInvalid: "Twikoo 客户端未正确初始化",
              clientMissingInit: "Twikoo 客户端未提供可用的初始化方法",
              scriptFailed: "无法加载 Twikoo 客户端脚本",
              unknownError: "未知错误"
            },
            en: {
              loadFailed: "Failed to load comments: ",
              clientInvalid: "The Twikoo client did not initialize correctly",
              clientMissingInit: "The Twikoo client did not provide a usable init method",
              scriptFailed: "Unable to load the Twikoo client script",
              unknownError: "Unknown error"
            }
          };

          function getTwikooLanguage(defaultLang) {
            try {
              var queryLang = new URLSearchParams(window.location.search).get("lang");
              var storedLang = window.localStorage.getItem("asheLanguage");
              var lang = queryLang || storedLang || defaultLang || "zh-CN";

              return twikooTextMap[lang] ? lang : "zh-CN";
            } catch (error) {
              return defaultLang || "zh-CN";
            }
          }

          function twikooText(key) {
            var lang = getTwikooLanguage(twikooLang);
            return (twikooTextMap[lang] && twikooTextMap[lang][key]) || twikooTextMap["zh-CN"][key];
          }

          function showTwikooError(message) {
            if (!twikooRoot) return;
            twikooRoot.innerHTML = "";
            var notice = document.createElement("p");
            notice.className = "twikoo-config-notice";
            notice.textContent = twikooText("loadFailed") + message;
            twikooRoot.appendChild(notice);
          }

          function keepSingleTwikooEmoji() {
            if (!twikooRoot) return;
            var controls = [];
            var seen = [];
            var submitAction = twikooRoot.querySelector(".tk-submit-action");
            var emojiNodes = submitAction
              ? submitAction.querySelectorAll(
                  ".tk-submit-action-icon.__emoji, .tk-submit-action-icon .tk-icon-emotion, .tk-submit-action-icon .tk-emotion, .tk-submit-action-icon .OwO-logo, .OwO, .tk-owo, .tk-icon-emotion, .tk-emotion"
                )
              : [];

            emojiNodes.forEach(function (item) {
              var control =
                item.closest(".tk-submit-action-icon") || item.closest(".tk-owo") || item.closest(".OwO") || item;

              if (seen.indexOf(control) !== -1) {
                return;
              }
              seen.push(control);
              controls.push(control);
            });

            controls.forEach(function (item, index) {
              item.classList.remove("ashe-emoji-primary");
              item.style.removeProperty("display");
              item.removeAttribute("hidden");

              if (index === 0) {
                item.classList.add("ashe-emoji-primary");
                return;
              }

              item.remove();
            });
          }

          function watchTwikooEmoji() {
            keepSingleTwikooEmoji();
            if (!twikooRoot || typeof MutationObserver !== "function") return;
            var timer = null;
            var observer = new MutationObserver(function () {
              window.clearTimeout(timer);
              timer = window.setTimeout(keepSingleTwikooEmoji, 50);
            });
            observer.observe(twikooRoot, { childList: true, subtree: true });
          }

          function loadTwikooClient() {
            return new Promise(function (resolve, reject) {
              if (resolveTwikooInit(window.twikoo)) {
                resolve(window.twikoo);
                return;
              }

              var script = document.createElement("script");
              script.src = twikooCdn;
              script.async = true;
              script.onload = function () {
                if (resolveTwikooInit(window.twikoo)) {
                  resolve(window.twikoo);
                } else {
                  reject(new Error(twikooText("clientInvalid")));
                }
              };
              script.onerror = function () {
                reject(new Error(twikooText("scriptFailed")));
              };
              document.head.appendChild(script);
            });
          }

          function resolveTwikooInit(twikoo) {
            var candidates = [
              twikoo,
              twikoo && twikoo.default,
              twikoo && twikoo.twikoo,
              twikoo && twikoo.default && twikoo.default.default
            ];

            for (var index = 0; index < candidates.length; index += 1) {
              var candidate = candidates[index];
              if (typeof candidate === "function") {
                return candidate;
              }
              if (candidate && typeof candidate.init === "function") {
                return candidate.init.bind(candidate);
              }
            }

            return null;
          }

          loadTwikooClient().then(function (twikoo) {
            var initTwikoo = resolveTwikooInit(twikoo);

            if (!initTwikoo) {
              throw new Error(twikooText("clientMissingInit"));
            }

            return initTwikoo({
              envId: twikooEnvId,
              el: "#twikoo",
              path: twikooPath,
              lang: getTwikooLanguage(twikooLang)
            });
          }).then(function () {
            watchTwikooEmoji();
          }).catch(function (error) {
            showTwikooError(error && error.message ? error.message : twikooText("unknownError"));
            console.error("[Twikoo]", error);
          });
        </script>
      ) : null}
    </section>

    <style>
      .comments-area {
        margin-top: 40px;
        padding-top: 0;
        border-top: 0;
      }

      .twikoo-config-notice {
        margin: 0;
        color: #888888;
        text-align: center;
      }

      .comments-area :global(.tk-comments-title),
      .comments-area :global(.tk-comments-count) {
        color: #333333;
      }

      .comments-area :global(.tk-input),
      .comments-area :global(.tk-textarea),
      .comments-area :global(.el-input__inner),
      .comments-area :global(.el-textarea__inner) {
        border-radius: 8px;
        border: 0 !important;
        border-color: transparent !important;
        box-shadow: none !important;
        outline: 0;
      }

      .comments-area :global(.el-input__inner:focus),
      .comments-area :global(.el-textarea__inner:focus) {
        border: 0 !important;
        box-shadow: none !important;
        outline: 0;
      }

      .comments-area :global(.el-textarea__inner) {
        background-image: var(--ashe-comment-textarea-image) !important;
        background-repeat: no-repeat !important;
        background-position: right 18px bottom 10px !important;
        background-size: 176px auto !important;
      }

      .comments-area :global(.tk-submit-action-icon.__markdown),
      .comments-area :global(.tk-submit-action-icon.__image),
      .comments-area :global(.tk-submit-action-icon.__emoji),
      .comments-area :global(.tk-submit-action-icon.__emoji ~ .tk-submit-action-icon.__emoji),
      .comments-area :global(.OwO),
      .comments-area :global(.tk-owo),
      .comments-area :global(.tk-icon-emotion),
      .comments-area :global(.tk-emotion) {
        display: none !important;
      }

      .comments-area :global(.tk-submit-action-icon.__emoji.ashe-emoji-primary),
      .comments-area :global(.tk-submit-action .ashe-emoji-primary),
      .comments-area :global(.ashe-emoji-primary .tk-icon-emotion),
      .comments-area :global(.ashe-emoji-primary .tk-emotion) {
        display: inline-flex !important;
      }

      .comments-area :global(.tk-submit) {
        border-radius: 8px;
      }

      .comments-area :global(.tk-submit-title) {
        display: none;
      }
    </style>
  )
}
