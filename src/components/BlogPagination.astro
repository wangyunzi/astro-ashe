---
import { paginationHref, type PaginationState } from "../lib/ashe";

interface Props {
  pagination: PaginationState & { basePath: string };
}

const { pagination } = Astro.props;
const { basePath, currentPage, totalPages } = pagination;

function visiblePages() {
  const pages: Array<number | "start-ellipsis" | "end-ellipsis"> = [];

  for (let page = 1; page <= totalPages; page += 1) {
    const isEdge = page === 1 || page === totalPages;
    const isNearCurrent = Math.abs(page - currentPage) <= 2;

    if (isEdge || isNearCurrent) {
      pages.push(page);
    } else if (page < currentPage && !pages.includes("start-ellipsis")) {
      pages.push("start-ellipsis");
    } else if (page > currentPage && !pages.includes("end-ellipsis")) {
      pages.push("end-ellipsis");
    }
  }

  return pages;
}
---

<nav class="blog-pagination numeric" aria-label="文章分页">
  {
    currentPage > 1 ? (
      <a class="numeric-prev-page" href={paginationHref(basePath, currentPage - 1)} data-i18n-en="Previous">
        上一页
      </a>
    ) : null
  }

  {
    visiblePages().map((page) =>
      typeof page === "number" ? (
        page === currentPage ? (
          <span aria-current="page">{page}</span>
        ) : (
          <a href={paginationHref(basePath, page)}>{page}</a>
        )
      ) : (
        <span class="pagination-ellipsis" aria-hidden="true">...</span>
      )
    )
  }

  {
    currentPage < totalPages ? (
      <a class="numeric-next-page" href={paginationHref(basePath, currentPage + 1)} data-i18n-en="Next">
        下一页
      </a>
    ) : null
  }
</nav>
