---
import { formatDate, postCover, postHref, type PostEntry } from "../lib/ashe";

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

{
  posts.length ? (
    <div class="related-posts clear-fix">
      <h3 data-i18n="post.related">你可能也喜欢</h3>
      {posts.map((post) => (
        <section>
          {
            postCover(post) ? (
              <a href={postHref(post)}>
                <img src={postCover(post)} alt={post.data.title} />
              </a>
            ) : null
          }
          <h4>
            <a href={postHref(post)}>{post.data.title}</a>
          </h4>
          <time class="related-post-date" datetime={post.data.date.toISOString()} data-i18n-date>
            {formatDate(post.data.date)}
          </time>
        </section>
      ))}
    </div>
  ) : null
}
