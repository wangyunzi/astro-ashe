---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
---

<BaseLayout title="404" titleEn="404" description="页面不存在" descriptionEn="Page not found" bodyClass="error404">
  <PageShell title="404">
    <div class="no-result-found">
      <h3 data-i18n="blog.noResultsTitle">没有找到内容</h3>
      <p data-i18n="error.notFoundText">你访问的页面不存在。</p>
    </div>
  </PageShell>
</BaseLayout>
