---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import { render } from "astro:content";
import { getPageBySlug } from "../lib/content";

const page = await getPageBySlug("about");

if (!page) {
  throw new Error('Missing content page: about');
}

const { Content } = await render(page);
const description = page.data.description || page.data.title;
const descriptionEn = page.data.descriptionEn || page.data.titleEn;
---

<BaseLayout
  title={page.data.title}
  titleEn={page.data.titleEn}
  description={description}
  descriptionEn={descriptionEn}
  bodyClass="page page-about"
>
  <PageShell title={page.data.title} titleEn={page.data.titleEn}>
    <Content />
  </PageShell>
</BaseLayout>
