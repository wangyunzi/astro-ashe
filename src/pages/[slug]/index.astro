---
import { entrySlug } from "../../lib/ashe";
import { getPageByPermalink, getPublishedPages } from "../../lib/content";

export async function getStaticPaths() {
  const pages = await getPublishedPages();
  return pages
    .filter((page) => !["about", "friends", "links"].includes(entrySlug(page)))
    .filter((page) => {
      const permalinkSlug = page.data.permalink.replace(/^\/+|\/+$/g, "");
      return permalinkSlug && permalinkSlug !== entrySlug(page);
    })
    .map((page) => page.data.permalink)
    .filter((permalink) => permalink !== "/")
    .map((permalink) => ({
      params: {
        slug: permalink.replace(/^\/+|\/+$/g, "")
      }
    }));
}

const slug = Astro.params.slug || "";
const page = await getPageByPermalink(`/${slug}/`);

if (!page) {
  return Astro.redirect("/404");
}

return Astro.redirect(page.data.permalink, 301);
---
