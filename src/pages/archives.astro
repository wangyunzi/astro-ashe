---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import BlogPagination from "../components/BlogPagination.astro";
import ArchiveYearGroups from "../components/ArchiveYearGroups.astro";
import { asheConfig } from "../ashe.config";
import { getPublishedPosts } from "../lib/content";

const posts = await getPublishedPosts();
const pageConfig = asheConfig.pages.archives;
const perPage = pageConfig.perPage;
const archiveYearGroups = posts.reduce<Array<{ year: number; posts: typeof posts }>>((items, post) => {
  const year = post.data.date.getFullYear();
  const current = items[items.length - 1];

  if (current?.year === year) {
    current.posts.push(post);
  } else {
    items.push({ year, posts: [post] });
  }

  return items;
}, []);
const totalPages = Math.max(1, Math.ceil(archiveYearGroups.length / perPage));
const currentPage = 1;
const currentPosts = archiveYearGroups.slice(0, perPage).flatMap((group) => group.posts);
---

<BaseLayout
  title={pageConfig.title}
  titleEn={pageConfig.titleEn}
  description={pageConfig.description}
  descriptionEn={pageConfig.descriptionEn}
  bodyClass="page page-archives archive"
>
  <PageShell title={pageConfig.title} titleEn={pageConfig.titleEn}>
    <ArchiveYearGroups posts={currentPosts} />
    {totalPages > 1 ? <BlogPagination pagination={{ currentPage, totalPages, perPage, totalItems: archiveYearGroups.length, basePath: "/archives/" }} /> : null}
  </PageShell>
</BaseLayout>
