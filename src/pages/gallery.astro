---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import GalleryIndex from "../components/GalleryIndex.astro";
import { getPublishedAlbums } from "../lib/content";

const albums = await getPublishedAlbums();
---

<BaseLayout title="相册" titleEn="Gallery" description="照片相簿集合" descriptionEn="Photo album collection" bodyClass="page page-gallery">
  <PageShell title="相册" titleEn="Gallery">
    <p data-i18n-en="Light, seasons, streets, and ordinary days are kept here as quiet proof that life once passed by beautifully.">
      光影、四季、街巷与寻常日子，都被安静地收在这里，作为生活曾经经过的痕迹。
    </p>

    <GalleryIndex albums={albums} />
  </PageShell>
</BaseLayout>
