---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import GalleryIndex from "../components/GalleryIndex.astro";
import { getPublishedAlbums } from "../lib/content";

const albums = await getPublishedAlbums();
---

<BaseLayout title="相册" description="照片相簿集合" bodyClass="page page-gallery">
  <PageShell title="相册" titleEn="Gallery">
    <p data-i18n-en="Open an album cover to browse its photos. Each album is written as Markdown images.">
      点击封面进入相簿。每个相册都是独立 Markdown 文件，正文只需要写图片语法。
    </p>

    <GalleryIndex albums={albums} />
  </PageShell>
</BaseLayout>
