---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import GalleryIndex from "../components/GalleryIndex.astro";
import { asheConfig } from "../ashe.config";
import { getPublishedAlbums } from "../lib/content";

const albums = await getPublishedAlbums();
const pageConfig = asheConfig.pages.gallery;
---

<BaseLayout
  title={pageConfig.title}
  titleEn={pageConfig.titleEn}
  description={pageConfig.description}
  descriptionEn={pageConfig.descriptionEn}
  bodyClass="page page-gallery"
>
  <PageShell title={pageConfig.title} titleEn={pageConfig.titleEn}>
    <p data-i18n-en={pageConfig.introEn}>{pageConfig.intro}</p>

    <GalleryIndex albums={albums} />
  </PageShell>
</BaseLayout>
