---
import BlogList from "../../components/BlogList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllTags, getPublishedPosts, findBySlug } from "../../lib/content";
import { paginatePosts, slugify, tagHref } from "../../lib/ashe";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getAllTags(posts).map((tag) => ({
    params: { slug: slugify(tag) },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag))
    }
  }));
}

const allPosts = await getPublishedPosts();
const { slug } = Astro.params;
const tag = Astro.props.tag || findBySlug(getAllTags(allPosts), slug || "");
const posts = Astro.props.posts || [];
const postPage = paginatePosts(posts, 1);
---

<BaseLayout
  title={`标签：${tag}`}
  titleEn={`Tag: ${tag}`}
  description={`标签 ${tag} 下的文章`}
  descriptionEn={`Posts tagged ${tag}.`}
  bodyClass="archive tag"
>
  <BlogList
    posts={postPage.items}
    title={`标签：${tag}`}
    titleEn={`Tag: ${tag}`}
    description={`标签 ${tag} 下的文章。`}
    descriptionEn={`Posts tagged ${tag}.`}
    pagination={{ ...postPage.pagination, basePath: tagHref(tag) }}
  />
</BaseLayout>
