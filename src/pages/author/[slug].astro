---
import BlogList from "../../components/BlogList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllAuthors, getPublishedPosts, findBySlug } from "../../lib/content";
import { authorHref, paginatePosts, slugify } from "../../lib/ashe";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getAllAuthors(posts).map((author) => ({
    params: { slug: slugify(author) },
    props: {
      author,
      posts: posts.filter((post) => post.data.author === author)
    }
  }));
}

const allPosts = await getPublishedPosts();
const { slug } = Astro.params;
const author = Astro.props.author || findBySlug(getAllAuthors(allPosts), slug || "");
const posts = Astro.props.posts || [];
const postPage = paginatePosts(posts, 1);
---

<BaseLayout
  title={`作者：${author}`}
  titleEn={`Author: ${author}`}
  description={`${author} 发布的文章`}
  descriptionEn={`Posts published by ${author}.`}
  bodyClass="archive author"
>
  <BlogList
    posts={postPage.items}
    title={`作者：${author}`}
    titleEn={`Author: ${author}`}
    description={`${author} 发布的文章。`}
    descriptionEn={`Posts published by ${author}.`}
    pagination={{ ...postPage.pagination, basePath: authorHref(author) }}
  />
</BaseLayout>
