---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageShell from "../../../components/PageShell.astro";
import BlogPagination from "../../../components/BlogPagination.astro";
import ArchiveYearGroups from "../../../components/ArchiveYearGroups.astro";
import { asheConfig } from "../../../ashe.config";
import { getPublishedPosts } from "../../../lib/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const perPage = asheConfig.pages.archives.perPage;
  const archiveYearGroups = posts.reduce<Array<{ year: number; posts: typeof posts }>>((items, post) => {
    const year = post.data.date.getFullYear();
    const current = items[items.length - 1];

    if (current?.year === year) {
      current.posts.push(post);
    } else {
      items.push({ year, posts: [post] });
    }

    return items;
  }, []);
  const totalPages = Math.max(1, Math.ceil(archiveYearGroups.length / perPage));

  return Array.from({ length: totalPages }, (_, index) => index + 1)
    .filter((page) => page > 1)
    .map((page) => ({
      params: { page: String(page) },
      props: { page }
    }));
}

const posts = await getPublishedPosts();
const pageConfig = asheConfig.pages.archives;
const perPage = pageConfig.perPage;
const archiveYearGroups = posts.reduce<Array<{ year: number; posts: typeof posts }>>((items, post) => {
  const year = post.data.date.getFullYear();
  const current = items[items.length - 1];

  if (current?.year === year) {
    current.posts.push(post);
  } else {
    items.push({ year, posts: [post] });
  }

  return items;
}, []);
const totalPages = Math.max(1, Math.ceil(archiveYearGroups.length / perPage));
const currentPage = Number(Astro.props.page || Astro.params.page || 1);
const start = (currentPage - 1) * perPage;
const currentPosts = archiveYearGroups.slice(start, start + perPage).flatMap((group) => group.posts);
---

<BaseLayout
  title={`${pageConfig.title} - 第 ${currentPage} 页`}
  titleEn={`${pageConfig.titleEn} - Page ${currentPage}`}
  description={pageConfig.description}
  descriptionEn={pageConfig.descriptionEn}
  bodyClass="page page-archives archive paged"
>
  <PageShell title={pageConfig.title} titleEn={pageConfig.titleEn}>
    <ArchiveYearGroups posts={currentPosts} />
    <BlogPagination pagination={{ currentPage, totalPages, perPage, totalItems: archiveYearGroups.length, basePath: "/archives/" }} />
  </PageShell>
</BaseLayout>
