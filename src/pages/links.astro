---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import feedCache from "../data/friends-feed-cache.json";
import { asheConfig } from "../ashe.config";
import { getPageBySlug } from "../lib/content";

const friendsPage = await getPageBySlug("friends");
const feedPage = {
  ...asheConfig.friendsFeed,
  ...(friendsPage?.data.feedPage ?? {})
};

const items = feedCache.items
  .map((item) => ({
    ...item,
    date: item.date ? new Date(item.date) : null
  }))
  .slice(0, feedPage.limit);

function formatAbsoluteTime(date: Date) {
  return new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit"
  }).format(date);
}

function formatAbsoluteTimeEn(date: Date) {
  return new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit"
  }).format(date);
}

function formatRelativeTime(date: Date) {
  const diff = Date.now() - date.getTime();
  const minute = 60 * 1000;
  const hour = 60 * minute;
  const day = 24 * hour;

  if (diff < hour) {
    return `${Math.max(1, Math.floor(diff / minute))} 分钟前`;
  }

  if (diff < day) {
    return `${Math.max(1, Math.floor(diff / hour))} 小时前`;
  }

  if (diff < day * 7) {
    return `${Math.max(1, Math.floor(diff / day))} 天前`;
  }

  return formatAbsoluteTime(date);
}

function formatRelativeTimeEn(date: Date) {
  const diff = Date.now() - date.getTime();
  const minute = 60 * 1000;
  const hour = 60 * minute;
  const day = 24 * hour;

  if (diff < hour) {
    const value = Math.max(1, Math.floor(diff / minute));
    return `${value} ${value === 1 ? "minute" : "minutes"} ago`;
  }

  if (diff < day) {
    const value = Math.max(1, Math.floor(diff / hour));
    return `${value} ${value === 1 ? "hour" : "hours"} ago`;
  }

  if (diff < day * 7) {
    const value = Math.max(1, Math.floor(diff / day));
    return `${value} ${value === 1 ? "day" : "days"} ago`;
  }

  return formatAbsoluteTimeEn(date);
}
---

<BaseLayout
  title={feedPage.title}
  titleEn={feedPage.titleEn}
  description={feedPage.description}
  descriptionEn={feedPage.descriptionEn}
  bodyClass="page page-links"
>
  <PageShell title={feedPage.title} titleEn={feedPage.titleEn} description={feedPage.description} descriptionEn={feedPage.descriptionEn}>
    {
      items.length ? (
        <div class="friends-feed-list friends-feed-moments">
          {items.map((item) => (
            <article class="friends-feed-item friends-moment-card">
              <div class="friends-moment-avatar-wrap">
                {item.avatar ? (
                  <img class="friends-feed-avatar" src={item.avatar} alt="" loading="lazy" />
                ) : (
                  <span class="friends-feed-avatar friends-feed-avatar-placeholder" aria-hidden="true">
                    {item.source.slice(0, 1)}
                  </span>
                )}
              </div>

              <div class="friends-moment-body">
                <div class="friends-moment-head">
                  <a class="friends-moment-name" href={item.sourceUrl} target="_blank" rel="noreferrer" data-i18n-en={item.sourceEn}>
                    {item.source}
                  </a>
                  {item.description ? <div class="friends-moment-bio" data-i18n-en={item.descriptionEn}>{item.description}</div> : null}
                </div>

                <div class="friends-moment-content">
                  <a class="friends-moment-title" href={item.link} target="_blank" rel="noreferrer">
                    {item.title}
                  </a>
                  {item.summary ? <p>{item.summary}</p> : null}
                </div>

                <div class="friends-moment-meta">
                  {item.date ? (
                    <time
                      datetime={item.date.toISOString()}
                      title={formatAbsoluteTime(item.date)}
                      data-i18n-en={formatRelativeTimeEn(item.date)}
                      data-i18n-title-en={formatAbsoluteTimeEn(item.date)}
                    >
                      {formatRelativeTime(item.date)}
                    </time>
                  ) : null}
                  {item.category ? <span>{item.category}</span> : null}
                  <a href={item.link} target="_blank" rel="noreferrer" data-i18n-en="Read original">查看原文</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="no-result-found">
          <h3 data-i18n-en="No feed items yet">暂时还没有抓到动态</h3>
          <p data-i18n-en="Check your configured RSS feeds or try again later.">
            请先运行缓存更新任务，或稍后等待定时任务刷新。
          </p>
        </div>
      )
    }
  </PageShell>
</BaseLayout>
