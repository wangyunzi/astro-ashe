---
import Parser from "rss-parser";
import { asheConfig } from "../ashe.config";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import { stripHtml } from "../lib/ashe";
import { getFeedLinks } from "../lib/content";

const parser = new Parser({
  timeout: 15000,
  headers: {
    "User-Agent": "Mozilla/5.0 (compatible; Astro Ashe Feed Reader/1.0; +https://asky.0tz.top)"
  }
});

const linksPage = asheConfig.linksPage;
const feedPage = linksPage.feedPage ?? {
  title: "友邻动态",
  titleEn: "Friends Feed",
  description: "通过 RSS 实时聚合友邻博客的最新更新。",
  descriptionEn: "A live RSS-powered stream of updates from friendly blogs.",
  path: "/friends/",
  limit: 80
};
const feeds = await getFeedLinks();

const responses = await Promise.all(
  feeds.map(async (feed) => {
    try {
      const parsed = await parser.parseURL(feed.data.feed);
      const items = (parsed.items || []).slice(0, 10).map((item) => {
        const rawDate = item.isoDate || item.pubDate || item.published || item.created || "";
        const date = rawDate ? new Date(rawDate) : null;
        const content = item.contentSnippet || stripHtml(item.content || item["content:encoded"] || "");
        const summary = content.trim().replace(/\s+/g, " ").slice(0, 180);

        return {
          title: item.title?.trim() || "未命名动态",
          link: item.link || feed.data.site,
          date,
          summary,
          source: feed.data.title,
          sourceEn: feed.data.titleEn,
          sourceUrl: feed.data.site,
          avatar: feed.data.avatar,
          description: feed.data.description,
          descriptionEn: feed.data.descriptionEn,
          category: feed.data.category
        };
      });

      return items;
    } catch (error) {
      console.error(`[friends] Failed to parse ${feed.data.feed}:`, error);
      return [];
    }
  })
);

const items = responses
  .flat()
  .sort((a, b) => {
    const aTime = a.date ? a.date.getTime() : 0;
    const bTime = b.date ? b.date.getTime() : 0;
    return bTime - aTime;
  })
  .slice(0, feedPage.limit);

function formatAbsoluteTime(date: Date) {
  return new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit"
  }).format(date);
}

function formatRelativeTime(date: Date) {
  const diff = Date.now() - date.getTime();
  const minute = 60 * 1000;
  const hour = 60 * minute;
  const day = 24 * hour;

  if (diff < hour) {
    return `${Math.max(1, Math.floor(diff / minute))} 分钟前`;
  }

  if (diff < day) {
    return `${Math.max(1, Math.floor(diff / hour))} 小时前`;
  }

  if (diff < day * 7) {
    return `${Math.max(1, Math.floor(diff / day))} 天前`;
  }

  return formatAbsoluteTime(date);
}
---

<BaseLayout title={feedPage.title} description={feedPage.description} bodyClass="page page-friends">
  <PageShell title={feedPage.title} titleEn={feedPage.titleEn}>
    <p data-i18n-en={feedPage.descriptionEn}>{feedPage.description}</p>

    {
      items.length ? (
        <div class="friends-feed-list friends-feed-moments">
          {items.map((item) => (
            <article class="friends-feed-item friends-moment-card">
              <div class="friends-moment-avatar-wrap">
                {item.avatar ? (
                  <img class="friends-feed-avatar" src={item.avatar} alt="" loading="lazy" />
                ) : (
                  <span class="friends-feed-avatar friends-feed-avatar-placeholder" aria-hidden="true">
                    {item.source.slice(0, 1)}
                  </span>
                )}
              </div>

              <div class="friends-moment-body">
                <div class="friends-moment-head">
                  <a class="friends-moment-name" href={item.sourceUrl} target="_blank" rel="noreferrer" data-i18n-en={item.sourceEn}>
                    {item.source}
                  </a>
                  {item.description ? <div class="friends-moment-bio" data-i18n-en={item.descriptionEn}>{item.description}</div> : null}
                </div>

                <div class="friends-moment-content">
                  <a class="friends-moment-title" href={item.link} target="_blank" rel="noreferrer">
                    {item.title}
                  </a>
                  {item.summary ? <p>{item.summary}</p> : null}
                </div>

                <div class="friends-moment-meta">
                  {item.date ? (
                    <time datetime={item.date.toISOString()} title={formatAbsoluteTime(item.date)}>
                      {formatRelativeTime(item.date)}
                    </time>
                  ) : null}
                  {item.category ? <span>{item.category}</span> : null}
                  <a href={item.link} target="_blank" rel="noreferrer">查看原文</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="no-result-found">
          <h3 data-i18n-en="No feed items yet">暂时还没有抓到动态</h3>
          <p data-i18n-en="Check your configured RSS feeds or try again later.">
            请检查 RSS 地址是否可用，或稍后再刷新页面。
          </p>
        </div>
      )
    }
  </PageShell>
</BaseLayout>
