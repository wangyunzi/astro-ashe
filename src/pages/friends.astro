---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinksPageGroups from "../components/LinksPageGroups.astro";
import PageShell from "../components/PageShell.astro";
import { getPageBySlug } from "../lib/content";

const friendsPage = await getPageBySlug("friends");

if (!friendsPage) {
  throw new Error('Missing friends data page: src/content/pages/friends.md');
}

const { Content } = await friendsPage.render();
const title = "好友链接";
const titleEn = "Friends";
const description = "整理博客朋友、常用资源和项目入口。";
const descriptionEn = "A curated list of friends, resources, and project links.";
---

<BaseLayout title={title} description={description} bodyClass="page page-friends">
  <PageShell title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn}>
    <LinksPageGroups page={friendsPage} />
    <Content />
  </PageShell>
</BaseLayout>
