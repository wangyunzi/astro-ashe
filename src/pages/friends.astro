---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinksPageGroups from "../components/LinksPageGroups.astro";
import PageShell from "../components/PageShell.astro";
import { render } from "astro:content";
import { getPageBySlug } from "../lib/content";

const friendsPage = await getPageBySlug("friends");

if (!friendsPage) {
  throw new Error('Missing friends data page: src/content/pages/friends.md');
}

const { Content } = await render(friendsPage);
const title = friendsPage.data.title;
const titleEn = friendsPage.data.titleEn;
const description = friendsPage.data.description || friendsPage.data.title;
const descriptionEn = friendsPage.data.descriptionEn || friendsPage.data.titleEn;
---

<BaseLayout title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn} bodyClass="page page-friends">
  <PageShell title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn}>
    <LinksPageGroups page={friendsPage} />
    <Content />
  </PageShell>
</BaseLayout>
