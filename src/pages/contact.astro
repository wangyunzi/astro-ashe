---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import { asheConfig } from "../ashe.config";

const pageConfig = asheConfig.pages.contact;
---

<BaseLayout
  title={pageConfig.title}
  titleEn={pageConfig.titleEn}
  description={pageConfig.description}
  descriptionEn={pageConfig.descriptionEn}
  bodyClass="page page-contact"
>
  <PageShell title={pageConfig.title} titleEn={pageConfig.titleEn}>
    <p data-i18n-en={pageConfig.introEn}>{pageConfig.intro}</p>
    <p data-i18n-en={pageConfig.noteEn}>{pageConfig.note}</p>
    <form class="wpcf7">
      <p>
        <label><span data-i18n="contact.name">姓名</span><input type="text" name="name" /></label>
      </p>
      <p>
        <label><span data-i18n="contact.email">邮箱</span><input type="email" name="email" /></label>
      </p>
      <p>
        <label><span data-i18n="contact.message">留言</span><textarea name="message"></textarea></label>
      </p>
      <p>
        <button class="submit" type="submit" data-i18n="contact.send">发送</button>
      </p>
    </form>
  </PageShell>
</BaseLayout>
